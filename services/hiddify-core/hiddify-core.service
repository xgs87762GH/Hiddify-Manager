[Unit]
After=network.target nss-lookup.target

[Service]
User=root
WorkingDirectory=/opt/hiddify-manager/services/hiddify-core
# 兜底：升级/重装窗口期若生成配置尚未写入 http_clients（例如新版 core 二进制短暂不可用，
# 版本探测退化为 0.0.0），sing-box 1.14+ 会对"隐式默认 HTTP 客户端"直接 FATAL 退出并崩溃重启。
# 打开该官方逃生阀后 core 只告警不退出，等下次 apply 重新生成带 http_clients 的配置即可自愈。
Environment=ENABLE_DEPRECATED_IMPLICIT_DEFAULT_HTTP_CLIENT=true
#CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
#AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
ExecStart=/opt/hiddify-manager/services/hiddify-core/hiddify-core srun -c /opt/hiddify-manager/generated/hiddify-core.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
LimitNOFILE=infinity
StandardOutput=file:/opt/hiddify-manager/data/log/hiddify-core.out.log
StandardError=file:/opt/hiddify-manager/data/log/hiddify-core.err.log
[Install]
WantedBy=multi-user.target