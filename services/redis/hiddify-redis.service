[Unit]
Description=Hiddify Redis
After=network.target
Documentation=http://redis.io/documentation, man:redis-server(1)

[Service]
Type=notify
ExecStart=/usr/bin/redis-server /opt/hiddify-manager/data/redis/redis.conf --supervised systemd --daemonize no
PIDFile=/var/run/hiddify-redis-server.pid
TimeoutStopSec=0
Restart=always
User=redis
Group=redis
RuntimeDirectory=hiddify-redis
RuntimeDirectoryMode=2755

UMask=007
PrivateTmp=yes
LimitNOFILE=65535
ProtectHome=yes
# 不要再加 PrivateDevices=yes：在部分内核/虚拟化环境下它建不出私有 /dev 命名空间，单元会以
# status=226/NAMESPACE 直接启动失败（redis 完全不需要访问 /dev）。
# 同理用 ProtectSystem=strict 代替早已废弃的 ReadOnlyDirectories=/：整棵树只读，只放行下面
# 这份白名单。
ReadWritePaths=-/var/lib/redis
ReadWritePaths=-/var/log/redis
ReadWritePaths=-/var/run/redis
ReadWritePaths=-/opt/hiddify-manager/data/redis
ReadWritePaths=-/opt/hiddify-manager/data/log

NoNewPrivileges=true
CapabilityBoundingSet=CAP_SETGID CAP_SETUID CAP_SYS_RESOURCE
MemoryDenyWriteExecute=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# 集群模式下 redis-server 会改写自己的配置文件，所以放行 /etc/redis。
ProtectSystem=strict
ReadWritePaths=-/etc/redis

[Install]
WantedBy=multi-user.target
