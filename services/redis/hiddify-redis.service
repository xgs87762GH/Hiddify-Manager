[Unit]
Description=Hiddify Redis
After=network.target
Documentation=http://redis.io/documentation, man:redis-server(1)

[Service]
Type=notify
ExecStart=/usr/bin/redis-server /opt/hiddify-manager/data/redis/redis.conf --supervised systemd --daemonize no
PIDFile=/var/run/hiddify-redis-server.pid
TimeoutStopSec=0
Restart=always
User=redis
Group=redis
RuntimeDirectory=hiddify-redis
RuntimeDirectoryMode=2755

UMask=007
PrivateTmp=yes
LimitNOFILE=65535
PrivateDevices=yes
ProtectHome=yes
# 这里曾经写的是已废弃的 `ReadOnlyDirectories=/`（把整棵树变只读）。在部分内核/systemd 组合上
# 它会让单元直接起不来（status=226/NAMESPACE），下面改用 ProtectSystem=full：只读 /usr /boot
# /etc，配合这份 ReadWritePaths 白名单 —— 这也是单元尾部注释推荐的做法。
ReadWritePaths=-/var/lib/redis
ReadWritePaths=-/var/log/redis
ReadWritePaths=-/var/run/redis
ReadWritePaths=-/opt/hiddify-manager/data/redis
ReadWritePaths=-/opt/hiddify-manager/data/log

NoNewPrivileges=true
CapabilityBoundingSet=CAP_SETGID CAP_SETUID CAP_SYS_RESOURCE
MemoryDenyWriteExecute=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# redis-server can write to its own config file when in cluster mode so we
# permit writing there by default. If you are not using this feature, it is
# recommended that you replace the following lines with "ProtectSystem=full".
# true == full：只读 /usr /boot /etc（不碰整棵树，避免上面的 226/NAMESPACE）。
ProtectSystem=true
ReadWritePaths=-/etc/redis

[Install]
WantedBy=multi-user.target
